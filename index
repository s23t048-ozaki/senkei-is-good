
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LINEAR TILE</title>
<style>
:root {
  --bg:#eef1f5;
  --ink:#202936;
  --muted:#788594;
  --line:#cbd3dd;
  --blue:#4775e7;
  --green:#169b75;
  --red:#d85b62;
}
* { box-sizing:border-box; }
body {
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
  overflow:hidden;
}
button { font:inherit; cursor:pointer; }
.screen {
  height:100dvh;
  width:100%;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:20px;
}
#start {
  position:absolute;
  inset:0;
  background:var(--bg);
  z-index:3;
  transition:transform .65s cubic-bezier(.65,0,.2,1);
}
#start.leave { transform:translateX(-100%); }
.logo-icon {
  display:grid;
  grid-template-columns:repeat(3,28px);
  gap:5px;
  margin-bottom:24px;
}
.logo-icon span {
  width:28px;
  height:28px;
  background:#fff;
  border:1px solid var(--line);
  border-radius:5px;
  box-shadow:0 3px 0 #cbd3dd;
}
.logo-icon span:nth-child(5),
.logo-icon span:nth-child(9) {
  background:var(--blue);
  border-color:var(--blue);
}
h1 {
  font-size:clamp(35px,8vw,58px);
  letter-spacing:.11em;
  margin:0;
}
.subtitle { color:var(--muted); margin:10px 0 42px; }
.primary {
  border:0;
  background:var(--blue);
  color:white;
  border-radius:12px;
  padding:15px 50px;
  font-weight:800;
  letter-spacing:.1em;
  box-shadow:0 5px 0 #2f52a9;
}
.primary:active {
  transform:translateY(3px);
  box-shadow:0 2px 0 #2f52a9;
}
#viewport { width:100%; overflow:hidden; }
#track {
  display:flex;
  width:200%;
  transition:transform .75s cubic-bezier(.65,0,.2,1);
}
#track.next { transform:translateX(-50%); }
.page { width:50%; flex-shrink:0; }
.panel {
  width:min(100%,460px);
  background:white;
  border:1px solid var(--line);
  border-radius:18px;
  padding:clamp(18px,4vw,30px);
  box-shadow:0 10px 35px #23304712;
}
.topline {
  display:flex;
  justify-content:space-between;
  font-size:12px;
  font-weight:700;
  letter-spacing:.1em;
  color:var(--muted);
}
.progress {
  height:5px;
  background:#e9edf3;
  border-radius:10px;
  margin:16px 0 26px;
  overflow:hidden;
}
.progress div { width:12%; height:100%; background:var(--blue); }
h2 { font-size:22px; margin:0 0 8px; }
.explain { color:var(--muted); font-size:13px; }
.equation {
  display:flex;
  align-items:center;
  justify-content:center;
  gap:clamp(6px,2vw,12px);
  padding:28px 0 32px;
}
.symbol { font-size:clamp(24px,7vw,34px); font-weight:750; }
.cell {
  width:clamp(51px,15vw,72px);
  height:clamp(51px,15vw,72px);
  display:grid;
  place-items:center;
  font-size:32px;
  font-weight:800;
  background:#f3f5f8;
  border:2px dashed #aab9cf;
  border-radius:9px;
  transition:background .15s,transform .15s;
}
.cell.over { background:#dce8ff; transform:scale(1.07); }
.cell.filled {
  border:2px solid var(--blue);
  background:#eaf0ff;
  color:var(--blue);
}
.section-label {
  font-size:11px;
  font-weight:800;
  letter-spacing:.13em;
  color:var(--muted);
  margin-bottom:10px;
}
.tiles {
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:9px;
}
.tile {
  height:clamp(42px,12vw,55px);
  border:1px solid #bdc7d4;
  border-radius:9px;
  background:#fff;
  color:var(--ink);
  font-size:22px;
  font-weight:750;
  box-shadow:0 4px 0 #d9dfe7;
  user-select:none;
  touch-action:none;
  cursor:grab;
}
.tile:active { cursor:grabbing; }
.tile.selected {
  background:#eaf0ff;
  border:2px solid var(--blue);
  color:var(--blue);
}
.signs { margin-top:15px; grid-template-columns:repeat(4,1fr); }
.signs .tile { color:#77869c; }
.actions {
  display:flex;
  gap:10px;
  margin-top:28px;
}
.actions button { flex:1; }
.secondary {
  border:1px solid var(--line);
  border-radius:11px;
  background:#f5f7fa;
  color:var(--ink);
  font-weight:700;
}
.message {
  min-height:25px;
  margin-top:14px;
  font-size:13px;
  text-align:center;
  font-weight:700;
}
.message.error { color:var(--red); }
.drag-ghost {
  position:fixed;
  z-index:100;
  width:58px;
  height:58px;
  border-radius:10px;
  background:var(--blue);
  color:white;
  display:grid;
  place-items:center;
  font-size:27px;
  font-weight:800;
  box-shadow:0 9px 25px #244e8e55;
  pointer-events:none;
  transform:translate(-50%,-50%);
}
#overlay {
  position:fixed;
  inset:0;
  background:#26354c55;
  display:none;
  align-items:center;
  justify-content:center;
  z-index:10;
}
#overlay.show { display:flex; }
.popup {
  background:white;
  border-radius:20px;
  text-align:center;
  padding:38px 50px;
  box-shadow:0 20px 70px #10203833;
  animation:pop .35s cubic-bezier(.2,1.5,.4,1);
}
.popup .check {
  font-size:54px;
  color:var(--green);
}
.popup h2 { font-size:30px; margin:12px 0; }
@keyframes pop {
  from { transform:scale(.5); opacity:0; }
  to { transform:scale(1); opacity:1; }
}
.end-icon { font-size:56px; color:var(--green); }
.end-panel { text-align:center; }
.end-panel p { color:var(--muted); line-height:1.8; }
.end-panel .primary { margin-top:20px; }
@media(max-height:640px) {
  .panel { padding:16px; }
  .equation { padding:12px 0; }
  .actions { margin-top:14px; }
  .progress { margin:9px 0 15px; }
}
@media(prefers-reduced-motion:reduce) {
  #track,#start { transition-duration:.01ms; }
  .popup { animation:none; }
}
</style>
</head>
<body>

<section id="start" class="screen">
  <div class="logo-icon" aria-hidden="true">
    <span></span><span></span><span></span>
    <span></span><span></span><span></span>
    <span></span><span></span><span></span>
  </div>
  <h1>LINEAR TILE</h1>
  <p class="subtitle">数字を並べて、数学を解き明かす。</p>
  <button class="primary" id="startButton">START →</button>
</section>

<main id="viewport">
  <div id="track">
    <section class="screen page">
      <div class="panel">
        <div class="topline">
          <span>CHAPTER 00 — BASIC</span>
          <span>01 / 08</span>
        </div>
        <div class="progress"><div></div></div>
        <h2>はじめの一歩</h2>
        <p class="explain">数字タイルを空欄に入れて、式を完成させよう。</p>

        <div class="equation">
          <span class="symbol">1</span>
          <span class="symbol">＋</span>
          <span class="symbol">1</span>
          <span class="symbol">＝</span>
          <div class="cell" id="answer" aria-label="回答欄">?</div>
        </div>

        <div class="section-label">NUMBER TILES</div>
        <div class="tiles" id="numbers"></div>

        <div class="section-label" style="margin-top:21px">
          OPERATOR TILES
        </div>
        <div class="tiles signs" id="signs"></div>

        <div class="actions">
          <button class="secondary" id="reset">リセット</button>
          <button class="primary" id="submit">決定 →</button>
        </div>
        <div class="message" id="message" aria-live="polite"></div>
      </div>
    </section>

    <section class="screen page">
      <div class="panel end-panel">
        <div class="end-icon">✓</div>
        <div class="topline" style="justify-content:center">
          STAGE 01 COMPLETE
        </div>
        <h2 style="margin-top:20px">ステージクリア！</h2>
        <p>
          最初の問題をクリアしました。<br>
          次の問題は、ここから追加できます。
        </p>
        <button class="primary" id="again">もう一度 →</button>
      </div>
    </section>
  </div>
</main>

<div id="overlay" role="dialog" aria-modal="true" aria-label="クリア">
  <div class="popup">
    <div class="check">✓</div>
    <h2>クリアー！</h2>
    <p>正解！ よくできました。</p>
  </div>
</div>

<script>
const numbers=document.getElementById("numbers");
const signs=document.getElementById("signs");
const answer=document.getElementById("answer");
const message=document.getElementById("message");
const overlay=document.getElementById("overlay");
const track=document.getElementById("track");

let value=null;
let dragging=null;
let ghost=null;
let originX=0,originY=0;
let moved=false;
let locked=false;
let audioContext=null;
let clearTimer=null;

function createTile(v,parent) {
  const el=document.createElement("button");
  el.className="tile";
  el.textContent=v;
  el.type="button";
  el.dataset.value=v;
  el.addEventListener("pointerdown",pointerDown);
  parent.append(el);
}

for(let i=0;i<=9;i++) createTile(String(i),numbers);
["＋","−","×","÷"].forEach(s=>createTile(s,signs));

function setAnswer(v) {
  if(locked)return;
  value=v;
  answer.textContent=v;
  answer.classList.add("filled");
  message.textContent="";
  document.querySelectorAll(".tile").forEach(t=>{
    t.classList.toggle("selected",t.dataset.value===v);
  });
}

function resetAnswer() {
  if(locked)return;
  value=null;
  answer.textContent="?";
  answer.classList.remove("filled");
  message.textContent="";
  message.className="message";
  document.querySelectorAll(".tile").forEach(t=>{
    t.classList.remove("selected");
  });
}

function pointerDown(e) {
  if(locked || e.button!==0)return;
  dragging=e.currentTarget;
  originX=e.clientX;
  originY=e.clientY;
  moved=false;
  dragging.setPointerCapture(e.pointerId);
  dragging.addEventListener("pointermove",pointerMove);
  dragging.addEventListener("pointerup",pointerUp,{once:true});
  dragging.addEventListener("pointercancel",pointerCancel,{once:true});
}

function pointerMove(e) {
  if(!dragging)return;
  if(!moved && Math.hypot(e.clientX-originX,e.clientY-originY)>6) {
    moved=true;
    ghost=document.createElement("div");
    ghost.className="drag-ghost";
    ghost.textContent=dragging.dataset.value;
    document.body.append(ghost);
  }
  if(!moved)return;
  ghost.style.left=e.clientX+"px";
  ghost.style.top=e.clientY+"px";
  const r=answer.getBoundingClientRect();
  const inside=e.clientX>=r.left && e.clientX<=r.right &&
               e.clientY>=r.top && e.clientY<=r.bottom;
  answer.classList.toggle("over",inside);
}

function pointerUp(e) {
  if(!dragging)return;
  const v=dragging.dataset.value;
  const r=answer.getBoundingClientRect();
  const inside=e.clientX>=r.left && e.clientX<=r.right &&
               e.clientY>=r.top && e.clientY<=r.bottom;
  if(!moved || inside)setAnswer(v);
  cleanupDrag();
}

function pointerCancel() { cleanupDrag(); }

function cleanupDrag() {
  if(dragging)dragging.removeEventListener("pointermove",pointerMove);
  if(ghost)ghost.remove();
  answer.classList.remove("over");
  dragging=null;
  ghost=null;
}

function playClearSound() {
  try {
    const AC=window.AudioContext||window.webkitAudioContext;
    if(!AC)return;
    if(!audioContext)audioContext=new AC();
    audioContext.resume();
    const start=audioContext.currentTime;
    [523.25,659.25,783.99,1046.5].forEach((freq,i)=>{
      const osc=audioContext.createOscillator();
      const gain=audioContext.createGain();
      const t=start+i*.105;
      osc.type="sine";
      osc.frequency.value=freq;
      gain.gain.setValueAtTime(.0001,t);
      gain.gain.exponentialRampToValueAtTime(.14,t+.018);
      gain.gain.exponentialRampToValueAtTime(.0001,t+.28);
      osc.connect(gain).connect(audioContext.destination);
      osc.start(t);
      osc.stop(t+.3);
    });
  }catch(e) { console.warn("Audio unavailable",e); }
}

function submitAnswer() {
  if(locked)return;
  if(value===null) {
    message.textContent="タイルを回答欄に入れてください。";
    message.className="message error";
    return;
  }
  if(value!=="2") {
    message.textContent="不正解！ もう一度考えてみよう。";
    message.className="message error";
    answer.animate(
      [{transform:"translateX(0)"},{transform:"translateX(-5px)"},
       {transform:"translateX(5px)"},{transform:"translateX(0)"}],
      {duration:280}
    );
    return;
  }
  locked=true;
  message.textContent="";
  overlay.classList.add("show");
  playClearSound();
  clearTimer=setTimeout(()=>{
    overlay.classList.remove("show");
    track.classList.add("next");
  },1250);
}

document.getElementById("startButton").addEventListener("click",()=>{
  document.getElementById("start").classList.add("leave");
});
document.getElementById("submit").addEventListener("click",submitAnswer);
document.getElementById("reset").addEventListener("click",resetAnswer);
answer.addEventListener("click",resetAnswer);
document.getElementById("again").addEventListener("click",()=>{
  clearTimeout(clearTimer);
  locked=false;
  resetAnswer();
  track.classList.remove("next");
  overlay.classList.remove("show");
});
</script>
</body>
</html>
